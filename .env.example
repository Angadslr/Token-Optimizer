# Use a local shell, OS keychain, or secret manager. Never commit real keys.
NVIDIA_API_KEY=
# Optional aliases and overrides:
DEEPSEEK_API_KEY=
SLASHTOKEN_OPTIMIZER_MODEL=deepseek-ai/deepseek-v4-flash
# Configure both values from the provider's current price sheet to enable cost reports.
# SLASHTOKEN_OPTIMIZER_INPUT_USD_PER_MILLION=
# SLASHTOKEN_OPTIMIZER_OUTPUT_USD_PER_MILLION=
# Load only benchmark-produced, reviewed, versioned auto-run thresholds.
# SLASHTOKEN_THRESHOLDS_PATH=/absolute/local/path/thresholds.json
# Set to 1 only for local development when python-dotenv should load .env.
# SLASHTOKEN_LOAD_DOTENV=1
# SLASHTOKEN_DATABASE_PATH=/absolute/local/path/slashtoken.sqlite3
# Codex run safety defaults, in seconds.
# SLASHTOKEN_CODEX_APPROVAL_TIMEOUT_SECONDS=600
# SLASHTOKEN_CODEX_DISCONNECT_GRACE_SECONDS=600
# SLASHTOKEN_CODEX_APPROVAL_RESOLUTION_SECONDS=10
# SLASHTOKEN_CODEX_INTERRUPT_TIMEOUT_SECONDS=10
# SLASHTOKEN_CODEX_SILENCE_WARNING_SECONDS=120
